{
  "expo": {
    "name": "Perfil3",
    "slug": "Perfil3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/dragon-ball-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/dragon-ball-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/dragon-ball-adaptive.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Perfil3"
    },
    "web": {
      "favicon": "./assets/dragon-ball-icon.png",
      "bundler": "metro"
    }
  }
}
